{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "sanitize",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-sanitize",
            "cacheVariables": {
                "ARQUILA_SANITIZE": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "sanitize",
            "configurePreset": "sanitize"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "sanitize",
            "configurePreset": "sanitize",
            "output": {
                "outputOnFailure": true
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "default",
            "steps": [
                {
                    "type": "configure",
                    "name": "default"
                },
                {
                    "type": "build",
                    "name": "default"
                },
                {
                    "type": "test",
                    "name": "default"
                }
            ]
        },
        {
            "name": "sanitize",
            "steps": [
                {
                    "type": "configure",
                    "name": "sanitize"
                },
                {
                    "type": "build",
                    "name": "sanitize"
                },
                {
                    "type": "test",
                    "name": "sanitize"
                }
            ]
        }
    ]
}
